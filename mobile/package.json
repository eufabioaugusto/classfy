{
  "name": "classfy-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-voice/voice": "^3.2.4",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-screen-orientation": "~9.0.9",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.21.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:personal": "CLASSFY_IOS_PERSONAL_TEAM=1 expo start --dev-client",
    "ios:device": "expo run:ios --device",
    "ios:device:personal": "CLASSFY_IOS_PERSONAL_TEAM=1 expo prebuild --platform ios && CLASSFY_IOS_PERSONAL_TEAM=1 expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "expo install --check",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:catalog": "node --experimental-strip-types --test src/features/home/catalog.test.mjs",
    "test:playback": "node --experimental-strip-types --test src/features/watch/playbackProgress.test.mjs",
    "test:rewards": "node --experimental-strip-types --test src/features/rewards/receiptQueue.test.mjs",
    "test:home": "node --experimental-strip-types --test src/features/home/ranking.test.mjs",
    "test:navigation": "node --experimental-strip-types --test src/features/navigation/primaryAction.test.mjs",
    "test:studio": "node --experimental-strip-types --test src/features/studio/*.test.mjs",
    "test:studio:headless": "node scripts/verify-studio-headless.mjs",
    "test:studio:media": "bash modules/classfy-studio-media/tests/verify-engine.sh",
    "test:studio:recipe": "bash modules/classfy-studio-media/tests/verify-recipe.sh",
    "test:studio:capture": "bash modules/classfy-studio-media/tests/verify-capture.sh",
    "test:studio:transcription": "bash modules/classfy-studio-media/tests/verify-transcription.sh"
  },
  "private": true
}
