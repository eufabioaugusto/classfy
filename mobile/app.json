{
  "expo": {
    "name": "Classfy",
    "slug": "classfy-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "classfy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "br.com.classfy.mobile",
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "br.com.classfy.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir uso do microfone para ditar mensagens.",
          "speechRecognitionPermission": "Permitir reconhecimento de voz para transcrever ditados."
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "A Classfy usa a câmera para gravar suas aulas no Studio.",
          "microphonePermission": "A Classfy usa o microfone para gravar o áudio das suas aulas e podcasts.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha vídeos e capas para seus projetos no Studio Classfy.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81d4f70f-940b-4487-8119-6039e4f47d56"
      }
    },
    "owner": "fabioarb"
  }
}
